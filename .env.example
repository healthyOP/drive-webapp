# Keep Firebase on Spark. Never put service account JSON in this repository.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Absolute path to a private key OUTSIDE this repository (forward slashes on Windows).
GOOGLE_APPLICATION_CREDENTIALS=
HOST=0.0.0.0
PORT=3000
# Optional absolute private data directory. Defaults to ./data beside server.js.
STORAGE_ROOT=
